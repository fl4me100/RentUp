<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
	<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
	<title>Test Suite 1</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Registo de Conta</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://rent-up-two.vercel.app/</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.btn-nav-solid</td><td>8000</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Criar conta')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=tab-register</td><td>5000</td></tr>
<tr><td>click</td><td>id=tab-register</td><td></td></tr>
<tr><td>type</td><td>id=r-name</td><td>João Silva Teste</td></tr>
<tr><td>type</td><td>id=r-email</td><td>katalon.test.${Math.random().toString(36).slice(2,8)}@mail.pt</td></tr>
<tr><td>type</td><td>id=r-pass</td><td>123456</td></tr>
<tr><td>select</td><td>id=r-region</td><td>label=Lisboa</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Criar conta gratuita')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.toast</td><td>10000</td></tr>
<tr><td>verifyText</td><td>css=.toast</td><td>Conta criada</td></tr>
</tbody></table>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Login + Anúncio</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://rent-up-two.vercel.app/</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.btn-nav-solid</td><td>8000</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Entrar')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=l-email</td><td>4000</td></tr>
<tr><td>type</td><td>id=l-email</td><td>demo@rentup.pt</td></tr>
<tr><td>type</td><td>id=l-pass</td><td>demo123</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Entrar na conta')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.user-chip</td><td>8000</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'+ Publicar')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=c-title</td><td>6000</td></tr>
<tr><td>type</td><td>id=c-title</td><td>Berbequim Bosch Teste Katalon</td></tr>
<tr><td>select</td><td>id=c-cat</td><td>label=Ferramentas</td></tr>
<tr><td>type</td><td>id=c-price</td><td>15</td></tr>
<tr><td>type</td><td>id=c-desc</td><td>Teste automatizado Katalon Recorder</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Publicar anúncio agora')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.toast</td><td>10000</td></tr>
<tr><td>verifyText</td><td>css=.toast</td><td>publicado com sucesso</td></tr>
</tbody></table>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Pesquisa e Filtros</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://rent-up-two.vercel.app/</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=nav-search</td><td>6000</td></tr>
<tr><td>type</td><td>id=nav-search</td><td>Berbequim</td></tr>
<tr><td>waitForElementPresent</td><td>css=.card</td><td>7000</td></tr>
<tr><td>select</td><td>id=f-region-select</td><td>label=Lisboa</td></tr>
<tr><td>type</td><td>id=f-min</td><td>5</td></tr>
<tr><td>type</td><td>id=f-max</td><td>30</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Aplicar filtros')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.listings-count</td><td>6000</td></tr>
</tbody></table>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Reservar objeto</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://rent-up-two.vercel.app/</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.btn-nav-solid</td><td>6000</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Entrar')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=l-email</td><td>4000</td></tr>
<tr><td>type</td><td>id=l-email</td><td>demo@rentup.pt</td></tr>
<tr><td>type</td><td>id=l-pass</td><td>demo123</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Entrar na conta')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.card</td><td>8000</td></tr>
<tr><td>click</td><td>css=.card:first-child</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>xpath=//button[contains(text(),'Pedir reserva')]</td><td>7000</td></tr>
<tr><td>click</td><td>xpath=//button[contains(text(),'Pedir reserva')]</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.cal-grid</td><td>6000</td></tr>
<tr><td>click</td><td>css=.cal-day-avail:nth-child(10)</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.cal-day-avail:nth-child(15)</td><td>4000</td></tr>
<tr><td>click</td><td>css=.cal-day-avail:nth-child(15)</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id=cal-confirm-btn</td><td>5000</td></tr>
<tr><td>click</td><td>id=cal-confirm-btn</td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.toast</td><td>8000</td></tr>
</tbody></table>
</body>
</html>
